# Public base URL of this server. Must match how clients reach it: it is
# advertised as the issuer and used for DPoP `htu` comparisons.
ISSUER=http://localhost:8080
PORT=8080

# SQLite file. The parent directory is created automatically.
DATABASE_PATH=./data/oauth.sqlite

# Signing key for browser session CSRF tokens. Required in production; if
# empty, an ephemeral secret is generated at startup.
SESSION_SECRET=

# Token lifetimes (seconds).
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTHORIZATION_CODE_TTL_SECONDS=60

# DPoP proof freshness window.
DPOP_IAT_TOLERANCE_SECONDS=60
DPOP_IAT_FUTURE_SKEW_SECONDS=5
DPOP_JTI_RETENTION_SECONDS=120

# How long a detected replay is kept in the admin UI.
REPLAY_MARKER_TTL_SECONDS=604800

# Password/client-secret hashing cost. Lower N only for tests.
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1

# Maximum form body size.
MAX_FORM_BODY_BYTES=32768

# Number of trusted reverse proxies (0 disables X-Forwarded-* handling).
TRUST_PROXY=false

ADMIN_ENABLED=true
REGISTRATION_ENABLED=true
